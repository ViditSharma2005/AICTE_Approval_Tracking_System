# --- Database (PostgreSQL) -------------------------------------------------
# Vercel serverless functions have no persistent disk, so SQLite cannot be used
# there. Use a hosted Postgres (Neon / Supabase / Vercel Marketplace) — the free
# tier is enough. The same database can be used for local development.
#
# DATABASE_URL           pooled connection (Neon: host contains "-pooler") — used at runtime
# DATABASE_URL_UNPOOLED  direct connection (no "-pooler")                  — used by prisma migrate
# Locally (e.g. Docker Postgres) both can be the same string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Any long random string (e.g. `openssl rand -base64 32`). CHANGE THIS for real deployments.
SESSION_SECRET="change-me-to-a-long-random-string"

DEMO_MODE="false"
DEMO_DAY_MS="10000"

# --- Optional: real AI providers -------------------------------------------
# Leave BOTH unset and every AI feature still works, using a deterministic
# offline engine (mock document reader + fixed, tool-backed chat answers).
# Set one to use a live model for OCR extraction and the portal assistant.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# GOOGLE_GENERATIVE_AI_API_KEY="..."
# GOOGLE_MODEL="gemini-2.0-flash"
